NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The app derives the OAuth callback as NEXT_PUBLIC_SITE_URL + "/auth/callback".
# Local dev should use http://localhost:3000/auth/callback and production should use the deployed HTTPS domain.

# Server-only Supabase keys. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth / Google OAuth configuration must match the Supabase dashboard settings.
# Set the site URL to http://localhost:3000 locally and the production HTTPS domain in deployed environments.
# Add http://localhost:3000/auth/callback and https://<your-domain>/auth/callback as redirect URLs in Supabase Auth.

ADMIN_EMAILS=
ADMIN_PASSWORD=
# Generate a unique secret with at least 32 characters. Keep it server-only.
ADMIN_SESSION_SECRET=
BKASH_PERSONAL_NUMBER=
NAGAD_PERSONAL_NUMBER=
CRON_SECRET=
